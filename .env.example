APP_ENV=development
APP_NAME=VI ClipForge
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./vi_clipforge.db
STORAGE_ROOT=../storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
MAX_UPLOAD_MB=500
PLATFORM_MODE=mock
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=VIClipForge/1.0
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_BEARER_TOKEN=
META_APP_ID=
META_APP_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPENAI_API_KEY=

# Optional workspace access token; required (32+ chars) for APP_ENV=production.
APP_ACCESS_TOKEN=
WORKER_ENABLED=true
PROCESSING_TIMEOUT_SECONDS=3600
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# Set to a text model available to your project; left unset to avoid assuming access.
AI_MODEL=
TRANSCRIPTION_MODEL=whisper-1
TELEGRAM_MAX_UPLOAD_MB=49

# Live Watch runs separately: ./scripts/watch.sh (or Compose watcher service).
# Twitch: user access token with chat:read; never paste tokens into chat or URLs.
TWITCH_USER_TOKEN=
TWITCH_CHAT_LOGIN=
STREAMLINK_BINARY=streamlink
LIVE_MAX_SESSIONS=2
# Budget counts all files under STORAGE_ROOT; original assets are never auto-deleted.
LIVE_STORAGE_GB=10
LIVE_MIN_FREE_GB=2
# Optional local whisper.cpp captions; install executable and model yourself.
WHISPER_BINARY=whisper-cli
WHISPER_MODEL_PATH=

# Daily gameplay feed is enabled in its UI; runs within the app (no Live Watch process required).
# Conservative publication floor based on Rockstar's announced release date; update if it changes.
DAILY_GAMEPLAY_NOT_BEFORE=2026-11-19
DAILY_CANDIDATE_LIMIT=60
LINK_MAX_DURATION_SECONDS=21600
LINK_DOWNLOAD_TIMEOUT_SECONDS=1800
